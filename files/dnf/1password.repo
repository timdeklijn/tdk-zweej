[1password]
name=1Password Stable Channel
baseurl=https://downloads.1password.com/linux/rpm/stable/$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://downloads.1password.com/linux/keys/1password.asc
# Terra (added for Ghostty) also rebuilds 1password and 1password-cli as
# 8.12.44-1.fc44. That release string outranks 1Password's own 8.12.44-1, so
# dnf would otherwise prefer Terra's copy — whose %post chowns
# /usr/share/1password/onepassword-mcp, a path it does not ship, aborting the
# transaction. Lower priority number wins in dnf, so pin upstream above Terra.
priority=1
