[Unit]
# Sets up Nushell extras: the generated starship/zoxide init files (rewritten
# when either binary changes version) and the managed config.nu/env.nu blocks.
# No network needed — starship and zoxide are in the image.
Description=Set up Nushell extras (starship autoload, zoxide, PATH)

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/setup-nu-extras.sh

[Install]
WantedBy=default.target
